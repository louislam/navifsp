###########################
# NaviFSP Configuration File
# How to use:
# Copy this file to .env and fill in the required values.
# For optional configs, don't forget to uncomment (Remove the leading #)
###########################

### Configs Since 1.0.0 ###

# [string] [required] Navidrome Base URL (e.g. https://yournavidrome.com)
NAVIFSP_BASE_URL=

# [string] [required] Navidrome username
NAVIFSP_USERNAME=

# [string] [required] Navidrome password
NAVIFSP_PASSWORD=

# [string] Drive letter or folder path to mount (default: N:)
#NAVIFSP_MOUNT=N:

# [true/false] Enable disk cache for song data (default: false)
#NAVIFSP_ENABLE_MUSIC_CACHE=false

# [true/false] Enable disk-based cover art cache (default: false)
#NAVIFSP_ENABLE_COVER_CACHE=false

# [string] Disk cache directory (default: %LOCALAPPDATA%\navifsp\cache)
#NAVIFSP_CACHE_DIR=

# [true/false] Auto-start on Windows login with --no-window (default: false)
#NAVIFSP_STARTUP_AT_LOGIN=false

# [true/false] Hide console window (default: false)
#NAVIFSP_NO_WINDOW=false

# [true/false] Enable debug logging (default: false)
#NAVIFSP_VERBOSE=false
